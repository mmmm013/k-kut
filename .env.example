# ─────────────────────────────────────────────────────────────────────────────
# K-KUT environment variable template
# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local or any file containing real secrets.
#
# In Vercel: add these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required — build will fail without these) ──────────────────────
# Found in: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ── Supabase service-role key (server-side only — keep secret) ───────────────
# Only needed for server-side admin operations (e.g. scripts/build-audio-manifest.mjs).
# DO NOT expose this to the browser. Do NOT prefix with NEXT_PUBLIC_.
# Found in: Supabase Dashboard → Project → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# SMS / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# K-KUT curated homepage Stripe Payment Links
# Short KUT — $4.99
NEXT_PUBLIC_MD_MOMENT_KK_LINK=
# HUG — $7.99 uses the locked Regular HUG Payment Link in app/checkout/route.ts
# Big HUG — $12.99
NEXT_PUBLIC_MD_FEATURED_KK_LINK=
# Existing section mapping retained for compatibility with controlled older routes.
NEXT_PUBLIC_MD_SECTION_KK_LINK=
