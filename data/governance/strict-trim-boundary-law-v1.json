{
  "schema_version": "GPMX_STRICT_TRIM_BOUNDARY_LAW_V3",
  "status": "OWNER_DIRECTED_CAPTURED_CC_CORRECTION_REQUIRED",
  "effective_date": "2026-09-02",
  "scope": [
    "KK",
    "SK",
    "MK",
    "HUG",
    "TUG",
    "BUG"
  ],
  "source_authority": "CAPTURED_CC_AUTHORITY_ONLY",
  "rules": {
    "universal_materializer_input": "DEDUPLICATED_CAPTURED_CC_CORRECTION_WORKLIST",
    "fresh_lt_pix_discovery_or_search_forbidden": true,
    "stored_captured_cc_must_be_reviewed": true,
    "hard_stop": "EXACT_ACOUSTIC_END_OF_LAST_AUDIBLE_VOCAL_NOTE",
    "corrected_end_replaces_stored_capture_end": true,
    "stop_exactly_at_last_vocal_note_end": true,
    "post_vocal_tail_allowed": false,
    "mid_vocal_cutoff_forbidden": true,
    "uncertain_boundary": "HOLD",
    "old_trim_reuse_without_review": false,
    "zero_default_post_vocal_padding": true,
    "gap_before_next_vocal_is_separator_not_tail": true,
    "adjacent_trms_require_distinct_cuts": true,
    "no_room_before_next_fresh_vocal": "CUT_BOTH_TRMS_DISTINCTLY_AT_THE_BREAK",
    "next_fresh_vocal_never_belongs_to_preceding_cc": true
  },
  "required_pass_state": "STRICT_LAST_VOCAL_NOTE_END_PASS",
  "required_checks": [
    "review the already captured CC",
    "locate the exact acoustic end of its last audible vocal note",
    "make a distinct cut before any new vocal/TRM, even when the gap is tiny",
    "confirm zero inherited or default post-vocal padding",
    "confirm no mid-vocal cutoff",
    "confirm no audio from the next vocal occurrence",
    "rendered audio listening verification"
  ],
  "publication_law": "No governed II may be materialized, served, or sold until its deduplicated captured-CC work item passes the exact last-vocal-note END review."
}
