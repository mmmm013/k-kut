    "public_description_must_describe_only_nblk": true,
    "public_mgs_must_describe_only_nblk": true,
    "admin_lineage_retained": [
      "source track title",
      "source track ID",
      "source file path or authority reference",
      "source SHA-256",
      "BLK ID",
      "NBLK ID",
      "Start TP",
      "End TP",
      "rights authority",
      "reviewer and decision evidence"
