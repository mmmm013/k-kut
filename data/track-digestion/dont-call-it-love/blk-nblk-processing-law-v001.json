      "structural label supported by the song",
      "authorized lyric text or transcript evidence",
      "audible beginning and ending proof",
      "speaker point of view",
      "relationship direction",
      "complete standalone or contextual meaning",
      "desire versus commitment position",
      "consent and boundary implications",
      "emotion mood sentiment intensity and time orientation",
      "positive meanings",
      "negative meanings",
      "contradictions and unsafe uses",
      "independent MGS",
      "source rights and lineage proof"
    ],
    "inherit_parent_meaning": false,
    "multiple_meanings_must_be_preserved": true,
    "contradictory_meanings_must_not_be_flattened": true,
    "no_complete_standalone_meaning_result": "BLK_ONLY_NO_NBLK",
    "unproven_result": "HOLD_BLK_REVIEW"
  },
  "nblk_law": {
