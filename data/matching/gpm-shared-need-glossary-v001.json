{
  "schema_version": "GPM_SHARED_NEED_GLOSSARY_V001",
  "status": "BIC_REVIEW_BRANCH_AUTHORITY",
  "authority": "GD / Greg Putnam · BIC-Level · LL/BP",
  "company": "G Putnam Music, LLC",
  "purpose": "Use one controlled vocabulary on both sides of matching: the customer's expressed need and the independently proven meaning of a governed music item.",
  "package_scope": ["HUG", "TUG", "BUG"],
  "required_dimensions": [
    "exact_user_words",
    "relationship",
    "point_of_view",
    "what_happened",
    "desired_effect",
    "primary_need",
    "emotion",
    "mood",
    "sentiment",
    "intensity",
    "time_orientation",
    "occasion",
    "positive_requirements",
    "exclusions",
    "contradictions"
  ],
  "matching_law": {
    "exact_user_words_remain_separate_from_interpretation": true,
    "customer_side_and_music_side_use_same_need_ids": true,
    "relationship_and_point_of_view_required_when_material": true,
    "parent_or_total_song_fit_never_auto_approves_a_child": true,
    "every_KK_KOMBO_sK_or_mK_fit_requires_independent_evidence": true,
    "one_music_item_may_fit_multiple_needs_only_with_separate_evidence": true,
    "positive_evidence_required": true,
    "exclusion_and_contradiction_review_required": true,
    "minimum_explained_candidates_when_available": 3,
    "forced_match_prohibited": true,
    "no_fit_label": "NO THEME FIT — HOLD",
    "inventory_identity_must_remain_separate_from_package_name": true
  },
  "evidence_layers": [
    "verified lyric or transcript meaning",
    "relationship and point of view",
    "desired recipient effect",
    "emotion mood sentiment and intensity",
    "audio presentation",
    "exact boundary and lineage",
    "rights and source authority",
    "customer-delivery audio and Twinkle-at-end proof",
    "conflicts exclusions and contraindications"
  ],
